x;margin-bottom: 8px;color: var(--text-main)}\n\n.setup-step p {font-size: 13.5px;color: var(--text-muted);line-height: 1.65}\n\n/* 客户端中性说明区块 */\n.client-neutral-box {margin-top: 24px;background-color: var(--bg-card);border: 1px solid var(--border-line);border-left: 5px solid var(--brick-red);padding: 26px 30px}\n\n.client-neutral-box p {font-size: 14.5px;color: var(--text-muted);margin-bottom: 14px}\n\n.client-neutral-box p:last-child {margin-bottom: 0}\n\n/* FAQ 展示：编号列表 */\n.faq-numbered-list {margin-top: 28px;list-style: none;counter-reset: faq-counter;display: flex;flex-direction: column;gap: 16px}\n\n.faq-item {background-color: var(--bg-card);border: 1px solid var(--border-line);border-left: 5px solid var(--brick-red);padding: 24px 28px 24px 20px;display: grid;grid-template-columns: 64px 1fr;align-items: baseline;gap: 16px}\n\n.faq-num {font-family: var(--font-serif);font-size: 26px;font-weight: 700;color: var(--brick-red);line-height: 1;font-feature-settings: \"tnum\"}\n\n.faq-content h3 {font-family: var(--font-serif);font-size: 17px;color: var(--text-main);margin-bottom: 8px}\n\n.faq-content p {font-size: 14px;color: var(--text-muted);line-height: 1.7}\n\n/* 底部文章声明 */\n.author-footnote {margin-top: 60px;padding: 30px 0;border-top: 1px solid var(--border-line);font-size: 13px;color: var(--text-light);line-height: 1.8}\n\n/* 导航：底部固定式文字导航 */\n.fixed-footer-nav {position: fixed;bottom: 0;left: 0;width: 100%;background-color: rgba(246, 243, 238, 0.94);backdrop-filter: blur(8px);border-top: 1px solid var(--border-line);z-index: 999;padding: 14px 0}\n\n.fixed-footer-nav .nav-inner {max-width: 1140px;margin: 0 auto;padding: 0 24px;display: flex;justify-content: space-between;align-items: center}\n\n.nav-brand {font-family: var(--font-serif);font-weight: 700;font-size: 15px;color: var(--brick-red);letter-spacing: 0.08em}\n\n.nav-links {display: flex;gap: 28px;list-style: none}\n\n.nav-links a {font-size: 13px;color: var(--text-muted);letter-spacing: 0.04em}\n\n.nav-links a:hover {color: var(--brick-red)}\n\n/* 响应式调整 */\n@media (max-width: 992px) {.plan-row {\n    grid-template-columns: 1fr;gap: 16px;}\n  .plan-row-features ul {\n    grid-template-columns: 1fr;}\n  .plan-row-action {\n    text-align: left;}\n  .dashboard-matrix {\n    grid-template-columns: 1fr;}\n  .cell-span-8, .cell-span-4, .cell-span-6 {\n    grid-column: span 1;}\n  .setup-guide-box {\n    grid-template-columns: 1fr;}\n  .essay-grid {\n    grid-template-columns: 1fr;}}\n\n@media (max-width: 640px) {\n  .hero-dashboard h1 {font-size: 28px}\n  .faq-item {grid-template-columns: 1fr;gap: 8px}\n  .fixed-footer-nav .nav-links {gap: 14px}\n}\n</style><div class=\"colophon-bar\">\n  <div class=\"shell\">\n    <span>网络基建观察笔记 · 第 1851 卷</span>\n    <span class=\"colophon-tag\">生产力分流体系</span>\n  </div>\n</div>\n\n<main class=\"shell\">\n  \n  <section class=\"hero-dashboard\" id=\"overview\">\n    <div class=\"headline-box\">\n      <h1>飞鱼的网络分流拓扑与节点资源编排</h1>\n      <p class=\"hero-intro\">\n        数据通道的本质并非无限泛滥的承诺，而是在既定带宽容量与设备边界内建立可预期的连通秩序。飞鱼通过分层节点池与多级流量矩阵，为研究人员、跨域协作团队及个人工作台提供条理清晰的路由选择。\n      </p>\n    </div>\n\n    <div class=\"dashboard-matrix\">\n      <div class=\"dash-cell cell-span-8\">\n        <div class=\"cell-kpi\">\n          <div>\n            <div class=\"metric-label\">核心路由机制与分流范式</div>\n            <div class=\"metric-value\">多级分流节点架构</div>\n          </div>\n          <p class=\"metric-desc\">\n            面向不同工作负载划分基础回程池与专线加速阵列。系统依靠分布式规则判断请求归属，在满足常规数据吞吐的同时，隔绝高峰拥塞对关键工单与流媒体通信的干扰。\n          </p>\n        </div>\n      </div>\n\n      <div class=\"dash-cell cell-span-4\">\n        <div class=\"cell-kpi\">\n          <div>\n            <div class=\"metric-label\">并发调度基准</div>\n            <div class=\"metric-value\">3 — 20 台</div>\n          </div>\n          <p class=\"metric-desc\">\n            按层级严格控制的终端并发上限，规避过度超售造成的节点雪崩，维持各端点间均等的信息交换质量。\n          </p>\n        </div>\n      </div>\n\n      <div class=\"dash-cell cell-span-4\">\n        <div class=\"cell-kpi\">\n          <div>\n            <div class=\"metric-label\">配额区间梯度</div>\n            <div class=\"metric-value\">100 — 1000 GB</div>\n          </div>\n          <p class=\"metric-desc\">\n            月度循环流量以整数阶梯展开，确保按需分配而不浪费主干链路储备。\n          </p>\n        </div>\n      </div>\n\n      <div class=\"dash-cell cell-span-4\">\n        <div class=\"cell-kpi\">\n          <div>\n            <div class=\"metric-label\">传输链路特性</div>\n            <div class=\"metric-value\">IPLC 专线优化</div>\n          </div>\n          <p class=\"metric-desc\">\n            在进阶方案中引入独立专线物理跨度，用以压缩往返抖动并提供低时延响应。\n          </p>\n        </div>\n      </div>\n\n      <div class=\"dash-cell cell-span-4\">\n        <div class=\"cell-kpi\">\n          <div>\n            <div class=\"metric-label\">调度支持协议</div>\n            <div class=\"metric-value\"><span class=\"status-indicator\"></span>通用分流订阅</div>\n          </div>\n          <p class=\"metric-desc\">\n            全面适配标准化协议配置文件，不依赖专有封闭框架，保证环境迁移的自由度。\n          </p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"section-anchor\" id=\"architecture\">\n    <span class=\"section-label\">工程随笔</span>\n    <h2 class=\"section-heading\">关于冗余、边界与连接确定性的思考</h2>\n    <p class=\"lead-essay\">\n      在网络链路的构建中，盲目堆砌纸面参数往往掩盖了工程底层的真实损耗。飞鱼的设计理念是将有限的网络预算投射在清晰的技术指标上，而非构建无法落地的空泛想象。\n    </p>\n\n    <div class=\"essay-grid\">\n      <div class=\"marked-card essay-entry\">\n        <h3>隔离优先的节点池划分</h3>\n        <p>\n          普通网络节点池主要承载日常网页浏览、静态代码依赖拉取与轻度数据回传；当系统检测到高敏感度的流媒体解析或游戏低抖动通信时，高阶订阅中的专线资源则可独立分担压力。\n        </p>\n        <p>\n          这种分层设计杜绝了单一重度任务拖垮整个节点集群的系统性风险，为每一类场景留下从容应对波动的带宽余量。\n        </p>\n      </div>\n\n      <div class=\"marked-card essay-entry\">\n        <h3>透明且可追溯的设备并发</h3>\n        <p>\n          每个账户所绑定的同时在线数并非单纯的商业限制，而是精准推算节点负载均衡因子的关键参考值。\n        </p>\n        <p>\n          通过在 3 台、5 台至 20 台之间明确分界，用户可以根据个人工作站或小微工作室的真实设备存量做出理性规划，避免在多平台重复登入时遭遇未知阻断。\n        </p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"section-anchor\" id=\"plans\">\n    <span class=\"section-label\">配置方案</span>\n    <h2 class=\"section-heading\">订阅规格与资源阶梯</h2>\n    <p class=\"lead-essay\">\n      所有计划均按月度周期提供固定的数据传输份额，并支持按年结算享受长周期折让。请依据设备规模与吞吐偏好选择相称的通道级别。\n    </p>\n\n    <div class=\"plan-rows-container\">\n      \n      <div class=\"plan-row\">\n        <div class=\"plan-row-name\">\n          <h3>基础版</h3>\n          <div class=\"plan-meta\">轻量查阅与日常工作节点</div>\n        </div>\n        <div class=\"plan-row-pricing\">\n          <div class=\"price-monthly\">¥15 <span>/月</span></div>\n          <div class=\"price-annual\">按年付仅需 ¥150/年</div>\n        </div>\n        <div class=\"plan-row-features\">\n          <ul>\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </div>\n        <div class=\"plan-row-action\">\n          <a href=\"#\" class=\"plan-btn\">选定此配置</a>\n        </div>\n      </div>\n\n      \n      <div class=\"plan-row featured\">\n        <div class=\"plan-row-name\">\n          <h3>旗舰版 <span class=\"plan-badge\">主力推荐</span></h3>\n          <div class=\"plan-meta\">涵盖专线与原生流媒体解析</div>\n        </div>\n        <div class=\"plan-row-pricing\">\n          <div class=\"price-monthly\">¥35 <span>/月</span></div>\n          <div class=\"price-annual\">按年付仅需 ¥350/年</div>\n        </div>\n        <div class=\"plan-row-features\">\n          <ul>\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n        </div>\n        <div class=\"plan-row-action\">\n          <a href=\"#\" class=\"plan-btn\">配置主力通道</a>\n        </div>\n      </div>\n\n      \n      <div class=\"plan-row\">\n        <div class=\"plan-row-name\">\n          <h3>团队版</h3>\n          <div class=\"plan-meta\">多工位并发与定制路由支持</div>\n        </div>\n        <div class=\"plan-row-pricing\">\n          <div class=\"price-monthly\">¥85 <span>/月</span></div>\n          <div class=\"price-annual\">按年付仅需 ¥850/年</div>\n        </div>\n        <div class=\"plan-row-features\">\n          <ul>\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </div>\n        <div class=\"plan-row-action\">\n          <a href=\"#\" class=\"plan-btn\">部署协作规格</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"section-anchor\" id=\"setup\">\n    <span class=\"section-label\">接入指引</span>\n    <h2 class=\"section-heading\">三步完成终端接入</h2>\n    <p class=\"lead-essay\">\n      无需繁琐的手动调试，标准化订阅凭证可在主流开源或第三方兼容内核中即开即用。\n    </p>\n\n    <div class=\"setup-guide-box\">\n      <div class=\"setup-step\">\n        <div class=\"step-order\">PHASE 01</div>\n        <h4>生成订阅凭证</h4>\n        <p>在飞鱼控制面板中确认所选套餐生效后，复制适配自身运行环境的加密分发链接或特定协议参数。</p>\n      </div>\n\n      <div class=\"setup-step\">\n        <div class=\"step-order\">PHASE 02</div>\n        <h4>加载配置至客户端</h4>\n        <p>将订阅链接导入本地已安装的通用代理软件中，执行一次全量节点抓取并测试各端点连通性延时。</p>\n      </div>\n\n      <div class=\"setup-step\">\n        <div class=\"step-order\">PHASE 03</div>\n        <h4>配置规则与分流模式</h4>\n        <p>推荐采用绕过大陆地址的规则策略，使本地局域网流量直连，特定跨域请求经由飞鱼节点透明递送。</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"section-anchor\" id=\"clients\">\n    <span class=\"section-label\">软件与生态说明</span>\n    <h2 class=\"section-heading\">客户端支持与环境兼容</h2>\n    <div class=\"client-neutral-box\">\n      <p>\n        <strong>中性说明：</strong>飞鱼不发行亦不绑定任何闭源的私有安装包。为维护使用者的数字主权与终端安全，飞鱼全线节点均遵循开放代理标准，全面兼容运行于 macOS、Windows、iOS、Android 以及 Linux 等系统平台的通用网络工具。\n      </p>\n      <p>\n        使用者应自行在操作系统官方应用商店或受信任的开源代码托管平台（如 GitHub 官方发布页）获取适宜的客户端程序，并通过标准化订阅链接实现配置同步。官方文档提供针对常见核心的规则编写范例与分流语法说明。\n      </p>\n    </div>\n  </section>\n\n  \n  <section class=\"section-anchor\" id=\"faq\">\n    <span class=\"section-label\">疑难解答</span>\n    <h2 class=\"section-heading\">常见问题与运行准则</h2>\n    <p class=\"lead-essay\">\n      关于服务周期、设备限制、退换策略与技术支持的真实说明，条目化呈列如下。\n    </p>\n\n    <ol class=\"faq-numbered-list\">\n      <li class=\"faq-item\">\n        <div class=\"faq-num\">01</div>\n        <div class=\"faq-content\">\n          <h3>设备同时在线数是如何计算的？</h3>\n          <p>\n            系统通过节点网关维护活跃的连接会话表。同一个订阅地址若在超过套餐所允许数量的物理设备上发起并发数据包交换，超额设备的新建连接将被自动搁置，直至旧会话释放。这一设计是为了保障共享母机上的端口性能不被突发并发击穿。\n          </p>\n        </div>\n      </li>\n\n      <li class=\"faq-item\">\n        <div class=\"faq-num\">02</div>\n        <div class=\"faq-content\">\n          <h3>流媒体解锁与普通节点池有什么具体差异？</h3>\n          <p>\n            基础版所包含的普通线路节点池足以覆盖日常静态资源的拉取与基础流媒体播放需求；而旗舰版与团队版则配备了具备原生住宅或数据中心特定属性的原生解析出口，能够有效避免因 IP 属性变更而触发的版权区域重定向。\n          </p>\n        </div>\n      </li>\n\n      <li class=\"faq-item\">\n        <div class=\"faq-num\">03</div>\n        <div class=\"faq-content\">\n          <h3>每月流量配额是否会在计费周期内结转？</h3>\n          <p>\n            不会结转。每月所分配的流量（如 100GB、300GB、1000GB）会在账单日准时重置。对于偶尔需要大规模拉取模型数据或超大文件的用户，建议按峰值月份的需求评估规格，或在团队版中咨询客户经理以进行配额临时上调。\n          </p>\n        </div>\n      </li>\n\n      <li class=\"faq-item\">\n        <div class=\"faq-num\">04</div>\n        <div class=\"faq-content\">\n          <h3>IPLC 专线游戏加速优化的技术路径是什么？</h3>\n          <p>\n            IPLC（International Private Leased Circuit）线路通过物理专线跨越地域边界，避开了公网公共节点的拥挤路由。这一路径显著消除了跨国光缆公网路由中不可控的跳点丢包，从而在延迟敏感的游戏或语音通信中提供恒定的平稳表现。\n          </p>\n        </div>\n      </li>\n\n      <li class=\"faq-item\">\n        <div class=\"faq-num\">05</div>\n        <div class=\"faq-content\">\n          <h3>遇到节点不可用时应如何排查？</h3>\n          <p>\n            首先建议在客户端内更新订阅，拉取最新的节点池域名解析；其次检查本地代理端口是否被其他安全软件拦截。若确认服务链路出现不可抗力中断，旗舰版及团队版用户可通过 7x24 优先工单系统提交节点追踪日志，技术运维人员会依据故障等级进行调度修复。\n          </p>\n        </div>\n      </li>\n    </ol>\n  </section>\n\n  \n  <div class=\"author-footnote\">\n    <p>\n      本文档由飞鱼网络观察小组定期校准更新。网络路由的本质在于协议与通道的理性规划，我们主张在透明规则下利用技术手段拓展信息的流动维度。文内标注的价格与配额均为基准牌价，如遇基础网络骨干变动，以控制台即时通告为准。\n    </p>\n  </div>\n</main>\n\n\n<nav class=\"fixed-footer-nav\" aria-label=\"页面固定导航\">\n  <div class=\"nav-inner\">\n    <div class=\"nav-brand\">飞鱼 FEIYU</div>\n    <ul class=\"nav-links\">\n      <li><a href=\"#overview\">仪表盘</a></li>\n      <li><a href=\"#architecture\">架构随笔</a></li>\n      <li><a href=\"#plans\">订阅阶梯</a></li>\n      <li><a href=\"#setup\">接入流程</a></li>\n      <li><a href=\"#clients\">软件环境</a></li>\n      <li><a href=\"#faq\">常见问题</a></li>\n    </ul>\n  </div>\n</nav>",
